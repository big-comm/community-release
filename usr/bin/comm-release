#!/bin/bash
# Wrapper to run comm-release

# Detect installation directory
# First look in standard system path, then fallback to local/dev directory
for i in /usr/share/comm-release; do
    if [[ -e "$i" ]]; then
        COMM_RELEASE_DIR="$i"
        break
    fi
done

# If not found, try local directory (development)
if [[ -z "$COMM_RELEASE_DIR" ]]; then
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
    COMM_RELEASE_DIR="$SCRIPT_DIR/../share/comm-release"
fi

# Execute main.py
exec python3 "$COMM_RELEASE_DIR/main.py" "$@"

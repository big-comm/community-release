#!/bin/bash
# Wrapper to run comm-release

# Resolve relative to this launcher so a source checkout can be previewed
# even when another version is already installed on the system.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
COMM_RELEASE_DIR="$SCRIPT_DIR/../share/comm-release"

# Execute main.py
exec python3 "$COMM_RELEASE_DIR/main.py" "$@"

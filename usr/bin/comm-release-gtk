#!/bin/bash
# Wrapper to run the comm-release GTK interface

# Use this checkout's files during a source preview, even when an older
# release is installed. In /usr/bin this resolves to /usr/share as usual.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
COMM_RELEASE_DIR="$SCRIPT_DIR/../share/comm-release"

# Execute gui.py
exec python3 "$COMM_RELEASE_DIR/gui.py" "$@"

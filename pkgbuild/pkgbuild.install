#!/usr/bin/env bash

# Color definitions for status messages
blueDark="\e[1;38;5;33m"
lightBlue="\e[1;38;5;39m"
cyan="\e[1;38;5;45m"
white="\e[1;97m"
reset="\e[0m"

# Print status messages
printMsg() {
    local message=$1
    echo -e "${blueDark}[${lightBlue}community-release${blueDark}]${reset} ${cyan}→${reset} ${white}${message}${reset}"
}


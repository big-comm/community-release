pkgname=community-release
pkgdesc="BigCommunity release definition"
# Uncomment and edit the following lines as needed
depends=('lsb-release' 'python' 'python-rich' 'python-gobject' 'gtk4' 'libadwaita')
#makedepends=('')
#optdepends=('')
conflicts=('manjaro-release')
provides=('manjaro-release')
#replaces=('')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
url="https://github.com/big-comm/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    cd "${srcdir}/${pkgname}"
    # Add any preparation steps here, if needed
    # For example: patch -p1 < "${srcdir}/patch-file.patch"
}

build() {
    cd "${srcdir}/${pkgname}"
    # Add build steps here, if needed
    # For example: make
}

check() {
    cd "${srcdir}/${pkgname}"
    # Add check/test steps here, if needed
    # For example: make check
}

package() {
    cd "${srcdir}/${pkgname}"

    # Determine the correct source directory
    if [ -d "${pkgname}" ]; then
        srcdir="${srcdir}/${pkgname}/${pkgname}"
    else
        srcdir="${srcdir}/${pkgname}"
    fi

    # Install files
    local dirs=("usr" "etc" "opt")
    for dir in "${dirs[@]}"; do
        if [ -d "${srcdir}/${dir}" ]; then
            cp -a "${srcdir}/${dir}" "${pkgdir}/"
        fi
    done

    # /etc/comm-release is the copy comm-release reads first (info.py). It is
    # generated from etc/lsb-release so there is a single source of truth in
    # the repository, and it exists because the ISO build rewrites
    # /etc/lsb-release: manjaro-tools' configure_lsb_release replaces
    # DISTRIB_RELEASE and DISTRIB_CODENAME with the build host's values, which
    # is how an ISO came out reading `26.1.1 / Bian-May` instead of the values
    # installed here. manjaro-tools does not know about this path.
    if [ -f "${pkgdir}/etc/lsb-release" ]; then
        install -Dm644 "${pkgdir}/etc/lsb-release" "${pkgdir}/etc/comm-release"
    fi

    # Ensure executables are executable
    for exe in comm-release comm-release-gtk; do
        if [ -f "${pkgdir}/usr/bin/${exe}" ]; then
            chmod 755 "${pkgdir}/usr/bin/${exe}"
        fi
    done

    # Install license file if present
    if [ -f "LICENSE" ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi

    # Install documentation if present
    if [ -f "README.md" ]; then
        install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
}
